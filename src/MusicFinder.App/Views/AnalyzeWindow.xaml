<Window x:Class="MusicFinder.App.Views.AnalyzeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Analyze BPM and key" Style="{StaticResource MF.Window}"
        Width="1180" Height="740" MinWidth="900" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseCommand}"/>
    </Window.InputBindings>

    <Grid Margin="22,18,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="{Binding Heading}" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Style="{StaticResource MF.Secondary}" TextWrapping="Wrap" Margin="0,4,0,0"
                       Text="MusicFinder listens to the audio and estimates the tempo and the key. These are estimates, not facts: check the ones you care about, and use ½ or ×2 when the tempo is off by an octave. Confident tempos are ticked for you; keys never are (they are the least reliable part). What is ticked is exactly what Write puts in the files."/>
        </StackPanel>

        <Border Grid.Row="1" Margin="0,12,0,0" Padding="12,8" CornerRadius="8" Background="{StaticResource MF.Brush.AccentSoft}"
                Visibility="{Binding HasMessage, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="{StaticResource MF.Brush.Warning}"/>
        </Border>

        <!-- ===== Review ===== -->
        <Grid Grid.Row="2" Margin="0,14,0,0" Visibility="{Binding IsReviewStep, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <ProgressBar Width="220" Height="6" VerticalAlignment="Center" Minimum="0" Maximum="{Binding ProgressTotal}" Value="{Binding ProgressDone, Mode=OneWay}"
                             Visibility="{Binding IsAnalysing, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Text="{Binding ProgressText}" Style="{StaticResource MF.Secondary}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                <Button Content="Stop" Style="{StaticResource MF.PillButton}" Height="30" Padding="14,0" Margin="10,0,0,0"
                        Command="{Binding StopCommand}" Visibility="{Binding IsAnalysing, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>

            <Border Grid.Row="1" Style="{StaticResource MF.Panel}">
                <DataGrid x:Name="ItemsGrid" ItemsSource="{Binding Items}" Style="{StaticResource MF.TrackGrid}" SelectionMode="Single"
                          AutoGenerateColumns="False" CanUserAddRows="False" Margin="4">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                            <Setter Property="MinHeight" Value="52"/>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Track" Width="1.3*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Label}"/>
                                        <TextBlock Text="{Binding Status}" Style="{StaticResource MF.Secondary}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="BPM now" Width="70">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding BpmNow}" VerticalAlignment="Center" Foreground="{StaticResource MF.Brush.TextSecondary}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="BPM estimate" Width="1.5*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <CheckBox IsChecked="{Binding WriteBpm, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanWriteBpm}" VerticalAlignment="Center"
                                                  Checked="Tick_Changed" Unchecked="Tick_Changed" ToolTip="Write this BPM"/>
                                        <TextBlock Text="{Binding BpmEstimateText}" VerticalAlignment="Center" Margin="8,0,8,0" MinWidth="86"/>
                                        <Button Content="½" Style="{StaticResource MF.PillButton}" Height="26" Width="30" Padding="0" ToolTip="Use half of this tempo"
                                                Command="{Binding DataContext.HalfTempoCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                Visibility="{Binding HasBpm, Converter={StaticResource BoolToVis}}"/>
                                        <Button Content="×2" Style="{StaticResource MF.PillButton}" Height="26" Width="34" Padding="0" Margin="4,0,0,0" ToolTip="Use double this tempo"
                                                Command="{Binding DataContext.DoubleTempoCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                Visibility="{Binding HasBpm, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Key now" Width="70">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding KeyNow}" VerticalAlignment="Center" Foreground="{StaticResource MF.Brush.TextSecondary}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Key estimate" Width="1.1*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <CheckBox IsChecked="{Binding WriteKey, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanWriteKey}" VerticalAlignment="Center"
                                                  Checked="Tick_Changed" Unchecked="Tick_Changed" ToolTip="Write this key"/>
                                        <TextBlock Text="{Binding KeyEstimateText}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Notes" Width="1.6*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding BpmNote}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource MF.Brush.Warning}"
                                                   Visibility="{Binding BpmNote, Converter={StaticResource NotNullToVis}}"/>
                                        <TextBlock Text="{Binding KeyNote}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource MF.Brush.Warning}"
                                                   Visibility="{Binding KeyNote, Converter={StaticResource NotNullToVis}}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <StackPanel Grid.Row="2" Margin="0,10,0,0">
                <StackPanel Orientation="Horizontal">
                    <Button Content="Tick all tempos" Style="{StaticResource MF.PillButton}" Height="32" Padding="14,0" Command="{Binding TickAllTemposCommand}"
                            ToolTip="Tempos are ticked for you only when the analysis was confident"/>
                    <Button Content="Tick all keys" Style="{StaticResource MF.PillButton}" Height="32" Padding="14,0" Margin="8,0,0,0" Command="{Binding TickAllKeysCommand}"
                            ToolTip="Keys are never ticked for you: they are the least reliable part of the analysis"/>
                    <Button Content="Untick all" Style="{StaticResource MF.PillButton}" Height="32" Padding="14,0" Margin="8,0,0,0" Command="{Binding UntickAllCommand}"/>
                    <Button Content="Analyze again" Style="{StaticResource MF.PillButton}" Height="32" Padding="14,0" Margin="8,0,0,0" Command="{Binding AnalyzeAgainCommand}"
                            ToolTip="Forget the remembered estimates of these tracks and listen again"/>
                </StackPanel>
                <TextBlock Text="{Binding WriteSummary}" FontWeight="SemiBold" Margin="0,10,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>

        <!-- ===== Writing ===== -->
        <StackPanel Grid.Row="2" Margin="0,60,0,0" VerticalAlignment="Top" MaxWidth="620" Visibility="{Binding IsWritingStep, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Writing tags…" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
            <ProgressBar Margin="0,16,0,8" Height="6" Minimum="0" Maximum="{Binding ProgressTotal}" Value="{Binding ProgressDone, Mode=OneWay}"/>
            <TextBlock Text="{Binding ProgressText}" Style="{StaticResource MF.Secondary}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </StackPanel>

        <!-- ===== Done ===== -->
        <ScrollViewer Grid.Row="2" Margin="0,30,0,0" VerticalScrollBarVisibility="Auto" Visibility="{Binding IsDoneStep, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Text="{Binding ResultSummary}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <ItemsControl ItemsSource="{Binding Failures}" Margin="0,16,0,0" Visibility="{Binding HasFailures, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource MF.Brush.RowAlt}" CornerRadius="8" Padding="12,8" Margin="0,0,0,8">
                                <TextBlock Text="{Binding}" Foreground="{StaticResource MF.Brush.Warning}" TextWrapping="Wrap"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- ===== Buttons ===== -->
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Visibility="{Binding IsReviewStep, Converter={StaticResource BoolToVis}}" VerticalAlignment="Center">
                <CheckBox Content="Replace a BPM or key the file already has" IsChecked="{Binding AllowOverwrite}"
                          ToolTip="Off: values already in your files are kept"/>
                <CheckBox Content="Keep a backup copy of each file before changing it" IsChecked="{Binding KeepBackup}" Margin="0,6,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Close" Style="{StaticResource MF.PillButton}" Margin="0,0,10,0" Command="{Binding CloseCommand}"
                        Visibility="{Binding IsReviewStep, Converter={StaticResource BoolToVis}}"/>
                <Button Content="{Binding WriteButtonText}" Style="{StaticResource MF.AccentButton}" Command="{Binding WriteCommand}" IsEnabled="{Binding CanWrite}"
                        Visibility="{Binding IsReviewStep, Converter={StaticResource BoolToVis}}"/>

                <Button Content="Stop after this file" Style="{StaticResource MF.PillButton}" Command="{Binding CancelWritingCommand}"
                        Visibility="{Binding IsWritingStep, Converter={StaticResource BoolToVis}}"/>

                <Button Content="Back to the list" Style="{StaticResource MF.PillButton}" Margin="0,0,10,0" Command="{Binding ContinueCommand}"
                        Visibility="{Binding IsDoneStep, Converter={StaticResource BoolToVis}}"/>
                <Button Content="Close" Style="{StaticResource MF.AccentButton}" Command="{Binding CloseCommand}"
                        Visibility="{Binding IsDoneStep, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
