<Window x:Class="MusicFinder.App.Views.DuplicatesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Duplicate files" Style="{StaticResource MF.Window}"
        Width="1100" Height="720" MinWidth="820" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseCommand}"/>
    </Window.InputBindings>

    <Grid Margin="22,18,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Duplicate files" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Style="{StaticResource MF.Secondary}" TextWrapping="Wrap" Margin="0,4,0,0"
                       Text="Files are compared by their content (SHA-256), not by name or tags, so a group here really is the same bytes. MusicFinder never deletes, moves or renames anything: open a file in Explorer or list it in the Library and decide there. The suggested copy only weighs play history and names, because identical files have identical audio and tags. If your DJ software has these files in playlists or crates, removing one of them there breaks that entry."/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,12,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Button Content="Scan for duplicates" Style="{StaticResource MF.AccentButton}" Height="34" Padding="16,0"
                        Command="{Binding ScanCommand}"/>
                <Button Content="Stop" Style="{StaticResource MF.PillButton}" Height="34" Padding="16,0" Margin="8,0,0,0"
                        Command="{Binding StopCommand}" Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" TextTrimming="None"/>
                <ProgressBar Margin="0,6,0,0" Maximum="{Binding ProgressMax}" Value="{Binding ProgressValue}"
                             Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
            <Button Grid.Column="2" Content="Show all in Library" Style="{StaticResource MF.PillButton}" Height="34" Padding="16,0"
                    Command="{Binding ShowAllInLibraryCommand}" Visibility="{Binding HasGroups, Converter={StaticResource BoolToVis}}"/>
        </Grid>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Focusable="False">
            <ItemsControl ItemsSource="{Binding Groups}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource MF.Panel}" Padding="14,12" Margin="0,0,0,10">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Heading}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding DetailText}" Style="{StaticResource MF.Secondary}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="List in Library" Style="{StaticResource MF.PillButton}" Height="28" Padding="12,0" Margin="8,0,0,0"
                                            Command="{Binding DataContext.ShowGroupInLibraryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"/>
                                    <Button Grid.Column="2" Content="Not a duplicate" Style="{StaticResource MF.PillButton}" Height="28" Padding="12,0" Margin="8,0,0,0"
                                            ToolTip="Hide this group. It stays hidden on later scans."
                                            Command="{Binding DataContext.DismissCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Members}" Margin="0,8,0,0" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="10,6" Margin="0,0,0,4" CornerRadius="6">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSuggested}" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource MF.Brush.AccentSoft}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="  suggested to keep" Foreground="{StaticResource MF.Brush.AccentHover}"
                                                                       Visibility="{Binding IsSuggested, Converter={StaticResource BoolToVis}}"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding FolderText}" Style="{StaticResource MF.Secondary}" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                        <TextBlock Text="{Binding FormatText}" HorizontalAlignment="Right"/>
                                                        <TextBlock Text="{Binding PlaysText}" Style="{StaticResource MF.Secondary}" HorizontalAlignment="Right"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="2" Content="Open in Explorer" Style="{StaticResource MF.PillButton}" Height="28" Padding="12,0"
                                                            Command="{Binding DataContext.RevealCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding KeepText}" Style="{StaticResource MF.Secondary}" TextWrapping="Wrap" Margin="10,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <TextBlock Text="{Binding SummaryText}" Style="{StaticResource MF.Secondary}" VerticalAlignment="Center"/>
            <Button Content="Close" Style="{StaticResource MF.PillButton}" Height="34" Padding="18,0" HorizontalAlignment="Right"
                    Command="{Binding CloseCommand}"/>
        </Grid>
    </Grid>
</Window>
