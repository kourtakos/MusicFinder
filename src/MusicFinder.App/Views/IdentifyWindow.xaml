<Window x:Class="MusicFinder.App.Views.IdentifyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Identify online" Style="{StaticResource MF.Window}"
        Width="1060" Height="800" MinWidth="860" MinHeight="620"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseCommand}"/>
    </Window.InputBindings>

    <Grid Margin="22,18,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="{Binding Heading}" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Style="{StaticResource MF.Secondary}" TextWrapping="Wrap" Margin="0,4,0,0"
                       Text="Candidates come from MusicBrainz. What is ticked below is exactly what Write will change; nothing is written before you press it."/>
        </StackPanel>

        <Border Grid.Row="1" Margin="0,12,0,0" Padding="12,8" CornerRadius="8" Background="{StaticResource MF.Brush.AccentSoft}"
                Visibility="{Binding HasMessage, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="{StaticResource MF.Brush.Warning}"/>
        </Border>


        <!-- ===== Overview: many tracks in one list ===== -->
        <Grid Grid.Row="2" Margin="0,14,0,0" Visibility="{Binding IsOverviewStep, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding OverviewSummary}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ProgressText}" Style="{StaticResource MF.Secondary}" VerticalAlignment="Center" Margin="14,0,0,0"/>
                    <Button Content="Stop" Style="{StaticResource MF.PillButton}" Height="30" Padding="14,0" Margin="10,0,0,0"
                            Command="{Binding CancelLookupsCommand}" Visibility="{Binding IsLookingUp, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
                <TextBlock Style="{StaticResource MF.Secondary}" TextWrapping="Wrap" Margin="0,4,0,8"
                           Text="Clear matches are ticked for you. Tracks that need your decision are left unticked, with the reason: open them with Review. The column “Will change” is what Write does to each file; empty fields are filled, values you already have are kept."/>
            </StackPanel>

            <Border Grid.Row="1" Style="{StaticResource MF.Panel}">
                <DataGrid x:Name="OverviewGrid" ItemsSource="{Binding Queue}" Style="{StaticResource MF.TrackGrid}" SelectionMode="Single"
                          SelectedItem="{Binding Current, Mode=TwoWay}" AutoGenerateColumns="False" CanUserAddRows="False" Margin="4">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                            <Setter Property="MinHeight" Value="48"/>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Write" Width="60">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding Include, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanInclude}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Checked="Include_Changed" Unchecked="Include_Changed"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Track" Binding="{Binding Label}" Width="1.2*" IsReadOnly="True"/>
                        <DataGridTemplateColumn Header="Found" Width="1.6*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding MatchText}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Attention}" Foreground="{StaticResource MF.Brush.Warning}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Attention}" Visibility="{Binding Attention, Converter={StaticResource NotNullToVis}}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Release" Binding="{Binding ReleaseText}" Width="1.1*" IsReadOnly="True"/>
                        <DataGridTemplateColumn Header="Will change" Width="1.7*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ChangesText}" TextWrapping="Wrap" VerticalAlignment="Center" ToolTip="{Binding ChangesText}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100" IsReadOnly="True"/>
                        <DataGridTemplateColumn Header="" Width="104">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Review…" Style="{StaticResource MF.PillButton}" Height="28" Padding="10,0"
                                            Command="{Binding DataContext.ReviewCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                <Button Content="Tick all clear matches" Style="{StaticResource MF.PillButton}" Height="32" Padding="14,0" Command="{Binding IncludeAllReadyCommand}"/>
                <Button Content="Untick all" Style="{StaticResource MF.PillButton}" Height="32" Padding="14,0" Margin="8,0,0,0" Command="{Binding IncludeNoneCommand}"/>
            </StackPanel>
        </Grid>

        <!-- ===== Choose ===== -->
        <Grid Grid.Row="2" Margin="0,14,0,0" Visibility="{Binding IsChooseStep, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- queue (only when several tracks) -->
            <Border Style="{StaticResource MF.Panel}" Width="250" Margin="0,0,14,0" Padding="6"
                    Visibility="{Binding HasQueue, Converter={StaticResource BoolToVis}}">
                <ListBox ItemsSource="{Binding Queue}" SelectedItem="{Binding Current, Mode=TwoWay}" BorderThickness="0" Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="4,4">
                                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Status}" Style="{StaticResource MF.Secondary}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- method and lookups -->
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Look up by" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ComboBox Style="{StaticResource MF.ComboBox}" ItemsSource="{Binding Methods}" SelectedItem="{Binding Method, Mode=TwoWay}"
                                  Width="260" Height="34" VerticalContentAlignment="Center">
                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}"/></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Content="Search again" Style="{StaticResource MF.PillButton}" Height="34" Padding="16,0" Margin="10,0,0,0"
                                Command="{Binding SearchAgainCommand}" ToolTip="Ask the service again, ignoring remembered answers"/>
                        <Button Content="Stop" Style="{StaticResource MF.PillButton}" Height="34" Padding="16,0" Margin="8,0,0,0"
                                Command="{Binding CancelLookupsCommand}" Visibility="{Binding IsLookingUp, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{Binding ProgressText}" Style="{StaticResource MF.Secondary}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </StackPanel>
                    <TextBlock Text="{Binding MethodNote}" Style="{StaticResource MF.Secondary}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>

                <!-- candidates -->
                <StackPanel Grid.Row="1" Margin="0,14,0,0" Visibility="{Binding HasCandidates, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Which recording is it?" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <Border Style="{StaticResource MF.Panel}" Padding="4">
                        <ListBox ItemsSource="{Binding Candidates}" SelectedItem="{Binding SelectedCandidate, Mode=TwoWay}" MaxHeight="190"
                                 BorderThickness="0" Background="Transparent">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="4,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold"/>
                                                <Run Text=" — "/>
                                                <Run Text="{Binding ArtistCredit, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding EvidenceText}" Style="{StaticResource MF.Secondary}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" Margin="12,0,0,0">
                                            <TextBlock Text="{Binding ScoreText}" HorizontalAlignment="Right"/>
                                            <TextBlock Text="{Binding DurationText}" Style="{StaticResource MF.Secondary}" HorizontalAlignment="Right"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                    <TextBlock Style="{StaticResource MF.Secondary}" TextWrapping="Wrap" Margin="0,6,0,0"
                               Text="The score is the one the service reported. Different services score differently, so two scores are never added up or compared."/>
                </StackPanel>

                <!-- release and its cover -->
                <Grid Grid.Row="2" Margin="0,14,0,0" Visibility="{Binding HasCandidates, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Which release? (album, year, track no., cover)" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <ComboBox Style="{StaticResource MF.ComboBox}" ItemsSource="{Binding Releases}" SelectedItem="{Binding SelectedRelease, Mode=TwoWay}"
                                  Height="34" VerticalContentAlignment="Center">
                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0"
                                Visibility="{Binding CoverEnabled, Converter={StaticResource BoolToVis}}">
                        <Border Style="{StaticResource MF.Panel}" Width="84" Height="84" VerticalAlignment="Bottom">
                            <Image x:Name="CoverImageBox" Source="{Binding CoverPicture}" Stretch="Uniform" Margin="2"/>
                        </Border>
                        <StackPanel Margin="10,0,0,0" Width="250" VerticalAlignment="Bottom">
                            <TextBlock Text="{Binding CoverStatus}" Style="{StaticResource MF.Secondary}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                            <CheckBox Content="Embed this cover" IsChecked="{Binding UseCover}" IsEnabled="{Binding HasCover}"
                                      ToolTip="From the Cover Art Archive. Written to the file only after you preview and confirm."/>
                            <CheckBox Content="Replace the cover the file has" IsChecked="{Binding ReplaceCover}" IsEnabled="{Binding HasCover}" Margin="0,4,0,0"
                                      Visibility="{Binding TrackHasCover, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- proposals -->
                <Grid Grid.Row="3" Margin="0,14,0,0" Visibility="{Binding HasCandidates, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="What would change (tick the fields to apply)" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <Border Grid.Row="1" Style="{StaticResource MF.Panel}">
                        <DataGrid ItemsSource="{Binding Proposals}" Style="{StaticResource MF.TrackGrid}" SelectionMode="Single"
                                  AutoGenerateColumns="False" CanUserAddRows="False" Margin="4">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                    <Setter Property="MinHeight" Value="34"/>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="Apply" Binding="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" Width="64"/>
                                <DataGridTextColumn Header="Field" Binding="{Binding FieldLabel}" Width="120" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Now" Binding="{Binding Current}" Width="*" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Proposed" Binding="{Binding Proposed}" Width="*" IsReadOnly="True"/>
                                <DataGridTextColumn Header="From" Binding="{Binding Source}" Width="1.1*" IsReadOnly="True"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                    <TextBlock Grid.Row="2" Text="{Binding ChangeSummary}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,10,0,0"/>
                </Grid>
            </Grid>
        </Grid>


        <!-- ===== Writing ===== -->
        <StackPanel Grid.Row="2" Margin="0,60,0,0" VerticalAlignment="Top" MaxWidth="620"
                    Visibility="{Binding IsWritingStep, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Writing tags…" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
            <ProgressBar Margin="0,16,0,8" Height="6" Minimum="0" Maximum="{Binding ProgressTotal}" Value="{Binding ProgressDone, Mode=OneWay}"/>
            <TextBlock Text="{Binding ProgressText}" Style="{StaticResource MF.Secondary}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </StackPanel>

        <!-- ===== Done ===== -->
        <ScrollViewer Grid.Row="2" Margin="0,30,0,0" VerticalScrollBarVisibility="Auto" Visibility="{Binding IsDoneStep, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Text="{Binding ResultSummary}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <ItemsControl ItemsSource="{Binding Failures}" Margin="0,16,0,0" Visibility="{Binding HasFailures, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource MF.Brush.RowAlt}" CornerRadius="8" Padding="12,8" Margin="0,0,0,8">
                                <TextBlock Text="{Binding}" Foreground="{StaticResource MF.Brush.Warning}" TextWrapping="Wrap"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- ===== Buttons ===== -->
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <CheckBox Content="Keep a backup copy of each file before changing it" IsChecked="{Binding KeepBackup}">
                    <CheckBox.Style>
                        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsOverviewStep}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                <DataTrigger Binding="{Binding IsChooseStep}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </CheckBox.Style>
                </CheckBox>
                <TextBlock Style="{StaticResource MF.Secondary}" TextWrapping="Wrap" MaxWidth="560" Margin="26,2,0,0"
                           Text="Backups go to MusicFinder's data folder, never next to your music. Every file is written through a verified temporary copy: a failure leaves the original untouched."
                           Visibility="{Binding KeepBackup, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <!-- list of many -->
                <Button Content="Close" Style="{StaticResource MF.PillButton}" Margin="0,0,10,0" Command="{Binding CloseCommand}"
                        Visibility="{Binding IsOverviewStep, Converter={StaticResource BoolToVis}}"/>
                <Button Content="{Binding WriteButtonText}" Style="{StaticResource MF.AccentButton}" Command="{Binding WriteCommand}" IsEnabled="{Binding CanWrite}"
                        Visibility="{Binding IsOverviewStep, Converter={StaticResource BoolToVis}}"/>

                <!-- one track in detail -->
                <Button Content="Back to the list" Margin="0,0,10,0" Command="{Binding BackToListCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource MF.PillButton}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsChooseStep}" Value="True"/>
                                        <Condition Binding="{Binding IsMany}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Close" Margin="0,0,10,0" Command="{Binding CloseCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource MF.PillButton}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsChooseStep}" Value="True"/>
                                        <Condition Binding="{Binding IsMany}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Write changes" Command="{Binding WriteCommand}" IsEnabled="{Binding CanWrite}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource MF.AccentButton}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsChooseStep}" Value="True"/>
                                        <Condition Binding="{Binding IsMany}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Content="Stop after this file" Style="{StaticResource MF.PillButton}" Command="{Binding CancelWritingCommand}"
                        Visibility="{Binding IsWritingStep, Converter={StaticResource BoolToVis}}"/>

                <Button Content="Continue" Style="{StaticResource MF.PillButton}" Margin="0,0,10,0" Command="{Binding ContinueCommand}"
                        Visibility="{Binding IsDoneStep, Converter={StaticResource BoolToVis}}"/>
                <Button Content="Close" Style="{StaticResource MF.AccentButton}" Command="{Binding CloseCommand}"
                        Visibility="{Binding IsDoneStep, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
