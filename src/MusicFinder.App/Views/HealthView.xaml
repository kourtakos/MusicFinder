<UserControl x:Class="MusicFinder.App.Views.HealthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MusicFinder.App.ViewModels">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="16,8,16,16" MaxWidth="1100" HorizontalAlignment="Stretch">
            <TextBlock Text="Library Health" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding SummaryText}" Style="{StaticResource MF.Secondary}" TextWrapping="Wrap" Margin="0,4,0,4"/>
            <TextBlock Style="{StaticResource MF.Secondary}" TextWrapping="Wrap" Margin="0,0,0,12"
                       Text="Pick a finding to list those tracks in the Library. From there you can edit tags (F2), identify (Ctrl+I), analyze BPM and key (Ctrl+B) or open the file in Explorer. Nothing here changes a file."/>

            <Button Content="Find duplicate files…" Style="{StaticResource MF.AccentButton}" HorizontalAlignment="Left" Height="34" Padding="16,0"
                    Margin="0,0,0,12" Command="{Binding FindDuplicatesCommand}"
                    ToolTip="Look for files with identical content. Nothing is deleted or changed."/>

            <Border Style="{StaticResource MF.Panel}" Padding="14,10" Margin="0,0,0,12"
                    Visibility="{Binding HasUnsupported, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding UnsupportedText}" TextWrapping="Wrap"/>
            </Border>

            <ItemsControl ItemsSource="{Binding Groups}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,18">
                            <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource MF.Secondary}" TextWrapping="Wrap" Margin="0,2,0,8"/>
                            <ItemsControl ItemsSource="{Binding Cards}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource MF.Panel}" Width="260" Margin="0,0,10,10" Padding="14,12"
                                                ToolTip="{Binding Explanation}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="{Binding CountText}" FontSize="26" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                            <Setter Property="Foreground" Value="{StaticResource MF.Brush.TextMuted}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasFindings}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource MF.Brush.Possible}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Grid.Row="1" Text="{Binding Title}" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                                <Button Grid.Row="2" Content="Show in Library" Style="{StaticResource MF.PillButton}"
                                                        HorizontalAlignment="Left" Height="28" Padding="12,0" Margin="0,10,0,0"
                                                        Command="{Binding ShowCommand}"
                                                        Visibility="{Binding CanShow, Converter={StaticResource BoolToVis}}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
