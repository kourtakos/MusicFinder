<Window x:Class="MusicFinder.App.Views.ProbableDuplicatesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Probable duplicates and other versions" Style="{StaticResource MF.Window}"
        Width="1100" Height="740" MinWidth="820" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <DataTemplate x:Key="GroupTemplate">
            <Border Style="{StaticResource MF.Panel}" Padding="14,12" Margin="0,0,0,10">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding Heading}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding DetailText}" Style="{StaticResource MF.Secondary}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="List in Library" Style="{StaticResource MF.PillButton}" Height="28" Padding="12,0" Margin="8,0,0,0"
                                Command="{Binding DataContext.ShowGroupInLibraryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"/>
                        <Button Grid.Column="2" Content="Not a duplicate" Style="{StaticResource MF.PillButton}" Height="28" Padding="12,0" Margin="8,0,0,0"
                                ToolTip="Hide this group. It stays hidden."
                                Command="{Binding DataContext.DismissCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Members}" Margin="0,8,0,0" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10,6" Margin="0,0,0,4" CornerRadius="6">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSuggested}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource MF.Brush.AccentSoft}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding VersionText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="  suggested to keep" Foreground="{StaticResource MF.Brush.AccentHover}"
                                                           Visibility="{Binding IsSuggested, Converter={StaticResource BoolToVis}}"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding FolderText}" Style="{StaticResource MF.Secondary}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding FormatText}" HorizontalAlignment="Right"/>
                                            <TextBlock Text="{Binding PlaysText}" Style="{StaticResource MF.Secondary}" HorizontalAlignment="Right"/>
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="Open in Explorer" Style="{StaticResource MF.PillButton}" Height="28" Padding="12,0"
                                                Command="{Binding DataContext.RevealCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding HintText}" Style="{StaticResource MF.Secondary}" TextWrapping="Wrap" Margin="10,4,0,0"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="22,18,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Probable duplicates and other versions" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Style="{StaticResource MF.Secondary}" TextWrapping="Wrap" Margin="0,4,0,8"
                       Text="Found from the artist, title and length in your tags, not from the audio, so these are suspicions to look at. A remix, an edit or a live version is a different version, not a duplicate, and is listed separately. MusicFinder never merges, moves, renames or deletes anything here."/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel>
                <TextBlock Text="Probably the same recording" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,2"/>
                <TextBlock Style="{StaticResource MF.Secondary}" Text="Same artist, title and version, and a length within 3 seconds." Margin="0,0,0,8"/>
                <ItemsControl ItemsSource="{Binding SameRecording}" ItemTemplate="{StaticResource GroupTemplate}" Focusable="False"/>

                <TextBlock Text="Songs in more than one version" FontSize="16" FontWeight="SemiBold" Margin="0,14,0,2"/>
                <TextBlock Style="{StaticResource MF.Secondary}" Text="The same song as a remix, edit, live version or with a clearly different length. Listed for information." Margin="0,0,0,8"/>
                <ItemsControl ItemsSource="{Binding OtherVersions}" ItemTemplate="{StaticResource GroupTemplate}" Focusable="False"/>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <TextBlock Text="{Binding SummaryText}" Style="{StaticResource MF.Secondary}" VerticalAlignment="Center"/>
            <Button Content="Close" Style="{StaticResource MF.PillButton}" Height="34" Padding="18,0" HorizontalAlignment="Right"
                    Command="{Binding CloseCommand}"/>
        </Grid>
    </Grid>
</Window>
