<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net$(NetVersion)-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>MusicFinder</AssemblyName>
    <RootNamespace>MusicFinder.App</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MusicFinder.Domain\MusicFinder.Domain.csproj" />
    <ProjectReference Include="..\MusicFinder.Application\MusicFinder.Application.csproj" />
    <ProjectReference Include="..\MusicFinder.Infrastructure\MusicFinder.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The WPF SDK leaves System.IO out of the implicit usings. -->
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

</Project>
