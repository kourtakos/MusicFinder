<UserControl x:Class="MusicFinder.App.Controls.AssignmentPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Grid>
        <ToggleButton x:Name="Toggle" Width="26" Height="26" Cursor="Hand" ToolTip="{Binding Tip, ElementName=Root}"
                      IsEnabled="{Binding Picker.IsEnabled, ElementName=Root}"
                      IsChecked="{Binding IsOpen, ElementName=Popup, Mode=TwoWay}">
            <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" CornerRadius="13" BorderThickness="1" BorderBrush="{StaticResource MF.Brush.InputBorder}"
                            Background="Transparent">
                        <TextBlock Style="{StaticResource MF.Icon}" Text="&#xE710;" FontSize="11" HorizontalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource MF.Brush.Accent}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource MF.Brush.AccentSoft}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource MF.Brush.Accent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </ToggleButton.Template>
        </ToggleButton>

        <Popup x:Name="Popup" PlacementTarget="{Binding ElementName=Toggle}" Placement="Bottom" VerticalOffset="6"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="None">
            <Border Style="{StaticResource MF.Panel}" Background="{StaticResource MF.Brush.PanelBg}"
                    BorderBrush="{StaticResource MF.Brush.InputBorder}" Padding="6" MinWidth="220" MaxWidth="320" Margin="0,0,12,12">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.5"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="{Binding Tip, ElementName=Root}" Style="{StaticResource MF.Secondary}" Margin="8,4,8,6"/>

                    <Border Grid.Row="1" Style="{StaticResource MF.InputBorder}" Height="32" Margin="2,0,2,6"
                            Visibility="{Binding HasSearch, ElementName=Root, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <TextBlock Text="Filter list…" IsHitTestVisible="False" Margin="10,0" VerticalAlignment="Center"
                                       Foreground="{StaticResource MF.Brush.TextMuted}" FontSize="12"
                                       Visibility="{Binding Picker.FilterText, ElementName=Root, Converter={StaticResource NotNullToVis}, ConverterParameter=Invert}"/>
                            <TextBox Style="{StaticResource MF.PlainTextBox}" Padding="10,0" FontSize="12"
                                     Text="{Binding Picker.FilterText, ElementName=Root, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                    </Border>

                    <ListBox Grid.Row="2" x:Name="List" ItemsSource="{Binding Picker.Choices, ElementName=Root}" MaxHeight="300"
                             Background="Transparent" BorderThickness="0" Focusable="False"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Focusable" Value="False"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Padding="6,5" CornerRadius="5" Background="Transparent">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource MF.Brush.RowHover}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <!-- A mixed row (null) turns fully on with one click; not three-state so users never cycle through "mixed". -->
                                <CheckBox x:Name="Box" Content="{Binding Label}" IsChecked="{Binding IsChecked, Mode=TwoWay}" IsThreeState="False"
                                          Margin="{Binding Depth, Converter={StaticResource DepthMargin}}"/>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsParent}" Value="True">
                                        <Setter TargetName="Box" Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</UserControl>
