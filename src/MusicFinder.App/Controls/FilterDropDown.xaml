<UserControl x:Class="MusicFinder.App.Controls.FilterDropDown"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Grid>
        <ToggleButton x:Name="Toggle" Style="{StaticResource MF.FilterToggle}"
                      IsChecked="{Binding IsOpen, ElementName=Popup, Mode=TwoWay}"
                      Content="{Binding ToggleText, ElementName=Root}"/>
        <Popup x:Name="Popup" PlacementTarget="{Binding ElementName=Toggle}" Placement="Bottom" VerticalOffset="6"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="None">
            <Border Style="{StaticResource MF.Panel}" Background="{StaticResource MF.Brush.PanelBg}"
                    BorderBrush="{StaticResource MF.Brush.InputBorder}" Padding="6" MinWidth="230" MaxWidth="360" Margin="0,0,12,12">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.5"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Appears for long lists (the genre taxonomy). Matching ignores case and accents. -->
                    <Border Style="{StaticResource MF.InputBorder}" Height="32" Margin="2,2,2,6"
                            Visibility="{Binding HasSearch, ElementName=Root, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <TextBlock Text="Filter list…" IsHitTestVisible="False" Margin="10,0" VerticalAlignment="Center"
                                       Foreground="{StaticResource MF.Brush.TextMuted}" FontSize="12"
                                       Visibility="{Binding FilterText, ElementName=Root, Converter={StaticResource NotNullToVis}, ConverterParameter=Invert}"/>
                            <TextBox x:Name="SearchBox" Style="{StaticResource MF.PlainTextBox}" Padding="10,0" FontSize="12"
                                     Text="{Binding FilterText, ElementName=Root, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                    </Border>

                    <ListBox Grid.Row="1" ItemsSource="{Binding Options, ElementName=Root}" MaxHeight="360" Background="Transparent"
                             BorderThickness="0" Focusable="False" SelectionMode="Single"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             Visibility="{Binding HasOptions, ElementName=Root, Converter={StaticResource BoolToVis}}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Focusable" Value="False"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Padding="6,5" CornerRadius="5" Background="Transparent">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource MF.Brush.RowHover}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <CheckBox x:Name="Box" Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              Margin="{Binding Depth, Converter={StaticResource DepthMargin}}"/>
                                    <TextBlock Text="{Binding CountText}" Style="{StaticResource MF.Secondary}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="28,0,4,0"/>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsParent}" Value="True">
                                        <Setter TargetName="Box" Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsVirtual}" Value="True">
                                        <Setter TargetName="Box" Property="FontStyle" Value="Italic"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Grid.Row="1" Text="Nothing to filter yet" Style="{StaticResource MF.Secondary}" Margin="10,8"
                               Visibility="{Binding HasOptions, ElementName=Root, Converter={StaticResource InvBoolToVis}}"/>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</UserControl>
